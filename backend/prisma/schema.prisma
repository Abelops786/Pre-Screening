generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RECRUITER
}

enum CandidateStatus {
  PENDING
  SYSTEM_CHECK_FAILED
  AUDIO_PENDING
  PROCESSING
  LEVEL1_PASSED
  REJECTED
  AUTO_DISQUALIFIED
  HIRED
}

enum Department {
  INTERPRETATION
  SALES
  CUSTOMER_SERVICE
}

enum JobStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum InterpretationClient {
  BIG_LANGUAGE
  TRANSPERFECT
  LANGO
  BOOSTLINGO
}

enum PositionType {
  US_BASED
  INTERNATIONAL
}

enum RoleType {
  DEDICATED_HOURLY
  PER_MINUTE
}

// Stage 2 enum – pre-built
enum AttendanceStatus {
  SCHEDULED
  CANDIDATE_JOINED
  RECRUITER_JOINED
  COMPLETED
  NO_SHOW
}

// ─────────────────────────────────────────────────────────────
// STAGE 1 MODELS
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(RECRUITER)
  department   String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedCandidates RecruiterCandidateAssignment[]
  internalNotes      InternalNote[]
  // Stage 2 relations – pre-built
  availability       RecruiterAvailability[]
  availabilityExceptions AvailabilityException[]
  interviews         Interview[]                    @relation("RecruiterInterviews")
  msAccessToken      String?                        @map("ms_access_token")
  msRefreshToken     String?                        @map("ms_refresh_token")

  @@map("users")
}

// Admin-managed departments. Each custom department maps to one of the three
// built-in questionnaire engines (Department enum) so clients can add new
// department names without needing new question sets.
model DepartmentConfig {
  id               String     @id @default(cuid())
  name             String     @unique
  questionnaireType Department @map("questionnaire_type")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("department_configs")
}

// Editable questionnaire definition — one per questionnaire engine.
// schema = { sections: [{ id, title, showIf?, fields: [{ key, label, type, options?, required?, placeholder?, optionsSource?, showIf?, protected? }] }] }
model QuestionnaireTemplate {
  id         String     @id @default(cuid())
  department Department @unique
  schema     Json
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("questionnaire_templates")
}

model Job {
  id                 String                @id @default(cuid())
  slug               String?               @unique
  title              String
  department         Department
  departmentLabel    String?               @map("department_label")
  language           String?
  status             JobStatus             @default(DRAFT)
  scheduledPublishAt DateTime?             @map("scheduled_publish_at")
  client             InterpretationClient?
  positionType       PositionType?         @map("position_type")
  roleType           RoleType?             @map("role_type")
  description        String?
  minDownloadSpeed   Float                 @default(20) @map("min_download_speed")
  minUploadSpeed     Float                 @default(10) @map("min_upload_speed")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  candidates         Candidate[]

  @@map("jobs")
}

model Candidate {
  id                   String          @id @default(cuid())
  fullName             String          @map("full_name")
  email                String
  phone                String
  location             String
  yearsExperience      Int?            @map("years_experience")
  availabilityShift    String?         @map("availability_shift")
  certifications       String[]
  cvUrl                String?         @map("cv_url")
  certificateUrl       String?         @map("certificate_url")
  selectedLanguage     String?         @map("selected_language")
  status               CandidateStatus @default(PENDING)
  department           Department?
  jobId                String?         @map("job_id")
  vocarooUrl           String?         @map("vocaroo_url")
  questionnaireAnswers Json?           @map("questionnaire_answers")
  autoDisqualifyReason String?         @map("auto_disqualify_reason")
  rejectionReason      String?         @map("rejection_reason")  // Rejected Offer | Failed IT | Failed Language Assessment | Other
  rejectionDetail      String?         @map("rejection_detail")  // free-text note from the recruiter
  deletedAt            DateTime?       @map("deleted_at")        // soft delete — purged permanently after 15 days
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  job                Job?                          @relation(fields: [jobId], references: [id])
  systemCheck        SystemCheck?
  audioRecording     AudioRecording?
  filterResult       FilterResult?
  emailLogs          EmailLog[]
  assignedRecruiters RecruiterCandidateAssignment[]
  internalNotes      InternalNote[]
  interviews         Interview[]

  // No uniqueness on email/job — candidates can apply freely (even after a
  // previous or deleted application). Resume of an in-progress application is
  // handled in code, not by a DB constraint.
  @@map("candidates")
}

model SystemCheck {
  id               String   @id @default(cuid())
  candidateId      String   @unique @map("candidate_id")
  downloadSpeed    Float    @map("download_speed")
  uploadSpeed      Float    @map("upload_speed")
  deviceType       String   @map("device_type")
  os               String
  browser          String
  micPermitted     Boolean  @map("mic_permitted")
  speakerPermitted Boolean  @map("speaker_permitted")
  passed           Boolean
  checkedAt        DateTime @default(now()) @map("checked_at")

  // ── Extended diagnostics (collected silently, admin/recruiter-only) ──
  screenResolution String?  @map("screen_resolution")
  cpuCores         Int?     @map("cpu_cores")
  deviceMemory     Float?   @map("device_memory")    // GB (browser-reported)
  connectionType   String?  @map("connection_type")  // 4g, wifi, etc.
  networkLatency   Int?     @map("network_latency")   // ms ping
  networkJitter    Int?     @map("network_jitter")    // ms
  micInputLevel    Int?     @map("mic_input_level")   // 0–100 peak sampled
  backgroundNoise  Int?     @map("background_noise")  // 0–100 ambient noise
  browserVersion   String?  @map("browser_version")
  timezone         String?  @map("timezone")          // browser IANA tz
  cpuArchitecture  String?  @map("cpu_architecture")  // e.g. x86-64bit
  gpuRenderer      String?  @map("gpu_renderer")       // integrated/discrete GPU name (hints at CPU era)
  ipAddress        String?  @map("ip_address")
  ipCountry        String?  @map("ip_country")
  vpnDetected      Boolean? @map("vpn_detected")
  vpnReason        String?  @map("vpn_reason")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("system_checks")
}

model AudioRecording {
  id                   String    @id @default(cuid())
  candidateId          String    @unique @map("candidate_id")
  audioUrl             String    @map("audio_url")
  durationSeconds      Float     @map("duration_seconds")
  transcript           String?
  fluencyScore         Float?    @map("fluency_score")
  aiScore              Float?    @map("ai_score")        // GPT fluency assessment 0–10
  aiFeedback           String?   @map("ai_feedback")     // short justification from GPT
  languageDetected     String?   @map("language_detected")
  whisperRawResponse   Json?     @map("whisper_raw_response")
  flaggedForHumanReview Boolean  @default(false) @map("flagged_for_human_review")
  processedAt          DateTime? @map("processed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("audio_recordings")
}

model FilterResult {
  id               String   @id @default(cuid())
  candidateId      String   @unique @map("candidate_id")
  filtersApplied   Json     @map("filters_applied")
  rejectionReasons String[] @map("rejection_reasons")
  qualified        Boolean
  totalScore       Float?   @map("total_score")        // weighted composite 0–100
  scoreBreakdown   Json?    @map("score_breakdown")    // sub-scores per component
  createdAt        DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("filter_results")
}

// Singleton: weights and pass threshold for the weighted scoring engine
model ScoringConfig {
  id                  String   @id @default("default")
  weightQuestionnaire Float    @default(0.4) @map("weight_questionnaire")
  weightAudio         Float    @default(0.4) @map("weight_audio")
  weightSpeed         Float    @default(0.1) @map("weight_speed")
  weightHeadphone     Float    @default(0.1) @map("weight_headphone")
  passThreshold       Float    @default(80)  @map("pass_threshold")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("scoring_config")
}

model EmailLog {
  id           String   @id @default(cuid())
  candidateId  String   @map("candidate_id")
  emailType    String   @map("email_type")
  sentAt       DateTime @default(now()) @map("sent_at")
  success      Boolean
  errorMessage String?  @map("error_message")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

model RecruiterCandidateAssignment {
  id          String   @id @default(cuid())
  recruiterId String   @map("recruiter_id")
  candidateId String   @map("candidate_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  recruiter User      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateId])
  @@map("recruiter_candidate_assignments")
}

model InternalNote {
  id          String   @id @default(cuid())
  candidateId String   @map("candidate_id")
  userId      String   @map("user_id")
  note        String
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("internal_notes")
}

// ─────────────────────────────────────────────────────────────
// STAGE 2 MODELS – Pre-built for Microsoft Teams integration.
// Activate by wiring MS_CLIENT_ID / MS_CLIENT_SECRET / MS_TENANT_ID.
// ─────────────────────────────────────────────────────────────

model RecruiterAvailability {
  id          String   @id @default(cuid())
  recruiterId String   @map("recruiter_id")
  dayOfWeek   Int      @map("day_of_week") // 0=Sun … 6=Sat
  startTime   String   @map("start_time")  // "HH:mm"
  endTime     String   @map("end_time")    // "HH:mm"
  isBooked    Boolean  @default(false) @map("is_booked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("recruiter_availability")
}

// A recruiter's one-off block: an entire day off/leave, or a specific time range
// on a given date. These override the weekly availability rules.
model AvailabilityException {
  id          String   @id @default(cuid())
  recruiterId String   @map("recruiter_id")
  date        DateTime @map("date")              // the calendar day (UTC midnight)
  allDay      Boolean  @default(true) @map("all_day")
  startTime   String?  @map("start_time")        // "HH:mm" when allDay = false
  endTime     String?  @map("end_time")          // "HH:mm" when allDay = false
  reason      String?                            // e.g. "Leave", "Personal"
  createdAt   DateTime @default(now()) @map("created_at")

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("availability_exceptions")
}

model Interview {
  id               String           @id @default(cuid())
  candidateId      String           @map("candidate_id")
  recruiterId      String           @map("recruiter_id")
  scheduledTime    DateTime         @map("scheduled_time")
  msTeamsLink      String?          @map("ms_teams_link")
  attendanceStatus AttendanceStatus @default(SCHEDULED) @map("attendance_status")
  recruiterJoinTime DateTime?       @map("recruiter_join_time")
  candidateJoinTime DateTime?       @map("candidate_join_time")
  waitTimeMinutes   Float?          @map("wait_time_minutes")
  recordingUrl      String?         @map("recording_url")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter User      @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("interviews")
}
