# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=recruiter
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=recruitment

# ─── Backend ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://recruiter:change_me_in_production@localhost:5432/recruitment

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# ─── OpenAI (Whisper) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── AWS S3 (or use STORAGE_PROVIDER=cloudinary below) ────────
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=recruitment-uploads

# ─── Cloudinary (alternative storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourcompany.com
SMTP_PASS=smtp_password
EMAIL_FROM=Recruitment Team <noreply@yourcompany.com>

# ─── Filtering Thresholds ─────────────────────────────────────
MIN_DOWNLOAD_SPEED_MBPS=5
MIN_UPLOAD_SPEED_MBPS=2
MIN_FLUENCY_SCORE=60

# ─── Stage 2 Placeholders (Microsoft Graph / Teams) ──────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:4000/api/v1/auth/ms/callback

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=TalentScreen
